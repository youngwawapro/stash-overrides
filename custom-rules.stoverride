name: 我的自定义规则
desc: Github 托管，防订阅覆盖

prepend-rules:
    - DOMAIN-KEYWORD,apple-relay,🧲 OpenAI
    - DOMAIN-SUFFIX,vercel.app,♻️ 手动切换
    - DOMAIN-SUFFIX,ultra.me,🧲 OpenAI
    - DOMAIN-SUFFIX,t-mobile.com,🧲 OpenAI
    - DOMAIN-SUFFIX,by.ltd,🧲 OpenAI
    - DOMAIN-SUFFIX,bws.lol, DIRECT

dns:
    fake-ip-filter:
        - +.unknowntec.com
